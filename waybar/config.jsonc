{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 5,
  "margin-left": 10,
  "margin-right": 10,

  "modules-center": ["group/left-pill", "clock", "group/right-pill"],

  "group/left-pill": {
    "orientation": "horizontal",
    "modules": [
      "hyprland/workspaces",
      "custom/weather"
    ]
  },

  "group/right-pill": {
    "orientation": "horizontal",
    "modules": [
      "bluetooth",
      "network",
      "pulseaudio",
      "battery"
    ]
  },

  "hyprland/workspaces": {
    "format": ""
  },

  "custom/weather": {
    "format": "{}",
    "tooltip": true,
    "interval": 60,
    "exec": "/home/moon/.config/waybar/scripts/weather-stats/weather-stats",
    "return-type": "json"
  },

  "bluetooth": {
    "format": "{icon}",
    "format-icons": {
      "enabled": "󰂯",
      "disabled": "󰂲"
    },
    "format-connected": "󰂱 {num_connections}",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "blueman-manager",
  },

  "network": {
    "format-wifi": "",
    "format-ethernet": "󰛳",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "interval": 5
  },

  "pulseaudio": {
    "format": "{icon} {volume}",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", "", ""]
    },
    "on-click": "pavucontrol"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
    },
    "tooltip-format": "{capacity}%"
  },

  "clock": {
    "timezone": "Europe/Paris",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%H:%M}",
    "interval": 1
  }
}
