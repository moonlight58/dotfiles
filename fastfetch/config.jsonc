// Nothing OS-themed fastfetch config
// Tokens: bg #1b1c1d | base #fdfdfd | accent #e2201f | muted #f5f0f08c
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty-direct",
        "source": "/home/moon/Downloads/signalis-white.png",
        "width": 35,
        "height": 17,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },

    "display": {
        "separator": " ",
        "color": {
            "keys": "#e2201f",
            "title": "#fdfdfd"
        },
        "size": {
            "binaryPrefix": "si"
        }
    },

    "modules": [
        {
            "type": "title",
            "format": "\u001b[38;2;226;32;31m{user-name}\u001b[0m@{host-name-colored}"
        },
        "separator",
        {
            "type": "os",
            "key": "󰣇 OS"
        },
        {
            "type": "kernel",
            "key": "󰌢 Kernel"
        },
        {
            "type": "uptime",
            "key": " Uptime"
        },
        {
            "type": "packages",
            "key": "󰏖 Packages"
        },
        {
            "type": "shell",
            "key": " Shell"
        },
        {
            "type": "wm",
            "key": " WM"
        },
        {
            "type": "terminal",
            "key": " Term"
        },
        "break",
        {
            "type": "cpu",
            "key": " CPU"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU"
        },
        {
            "type": "memory",
            "key": "󰍛 Memory"
        },
        {
            "type": "disk",
            "key": " Disk"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
