;; Import widgets
(include "./music-player.yuck")
(include "./monitor.yuck")
(include "./nothing-clock.yuck")

;; Time vars
(defpoll HOUR :interval "5s" `date +\"%H\"`)
(defpoll MIN :interval "5s" `date +\"%M\"`)
(defpoll MONTH :interval "5s" `date +\"%B\"`)
(defpoll DAY :interval "5s" `date +\"%d  %a\"`)

(defwidget clock []
  (box :orientation "h" :space-evenly false :halign "center"
    (label :class "clock-day"     :text DAY :angle 90)
    (label :class "clock-hour"    :text HOUR)
    (label :class "clock-divider" :text ":")
    (label :class "clock-min"     :text MIN)
    (label :class "clock-month"   :text MONTH :angle 90)))

(defwindow clock :stacking "bg" 
                 :monitor 0
                 :anchor "bottom right"
                 :focusable "false"
                 :geometry (geometry :x "63%" 
                                     :y "75%" 
                                     :width "300px"
                                     :height "100px")
    (clock))
