;; Import widgets
(include "./music-player.yuck")
(include "./monitor.yuck")
(include "./nothing-clock.yuck")

;; Time vars
(defpoll HOUR  :interval "5s" `date +\"%H\"`)
(defpoll MIN   :interval "5s" `date +\"%M\"`)
(defpoll DAY   :interval "60s" `date +\"%a\"`)
(defpoll DAY_N :interval "60s" `date +\"%d\"`)
(defpoll MONTH :interval "60s" `date +\"%B\"`)

(defwidget clock []
  (box :orientation "v" :space-evenly false :valign "center"
    (box :orientation "h" :space-evenly false :halign "center"
      (label :class "clock-hour"    :text HOUR)
      (label :class "clock-divider" :text ":")
      (label :class "clock-min"     :text MIN))

    (box :orientation "h" :space-evenly false :halign "fill"
      (label :class "clock-day"   :text DAY)
      (box :hexpand true)
      (label :class "clock-day-n" :text DAY_N)
      (box :hexpand true)
      (label :class "clock-month" :text MONTH))))

(defwindow clock :stacking "bg" 
                 :monitor 0
                 :focusable "false"
                 :geometry (geometry :x "6%" 
                                     :y "2%" 
                                     :width "400px"
                                     :height "120px"
                                     :anchor "bottom right")
    (clock))
