(defpoll gpu_usage
  :interval "1s"
  :initial "0"
  "~/.config/eww/scripts/getgpu")

(defpoll cpu_temp
  :interval "5s"
  :initial "0"
  "~/.config/eww/scripts/gettemp")

(defwidget monitor []
  (box :class "monitor"
       :orientation "v"
       :space-evenly true
       (metric :icon ""
               :label "CPU"
               :bar {EWW_CPU.avg}
               :perc {round(EWW_CPU.avg, 2)}
               :temp {cpu_temp})
       (metric :icon ""
               :label "RAM"
               :bar {EWW_RAM.used_mem_perc}
               :perc {round(EWW_RAM.used_mem_perc, 2)})
       (metric :icon "󰢮"
               :label "GPU"
               :bar {gpu_usage}
               :perc {gpu_usage}
               :temp {cpu_temp})))

(defwidget metric [icon label bar perc ?temp]
  (box :class "metric-monitor"
       :orientation "h"
       :space-evenly false

       (label    :class "icon-metric"
                 :text icon)
       (label    :class "label-metric"
                 :text label)
       (progress :class "progress-metric"
                 :valign "center"
                 :orientation "h"
                 :value bar)
       (label    :class "value-metric"
                 :halign "end"
                 :xalign 1
                 :text "${perc}%")
       (label    :class "temp-icon-metric"
                 :visible {temp != ""}
                 :text "󰈸")
       (label    :class "temp-metric"
                 :visible {temp != ""}
                 :text "${temp}°")))

(defwindow monitor
  :monitor 0
  :stacking "bg"
  :focusable "false"
  :geometry (geometry :x "55%"
                      :y "82%"
                      :width "370px"
                      :height "100px")
  (monitor))
